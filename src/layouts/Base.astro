---
import "../styles/site.css";
import { canonicalURL, searchDescription } from "../lib/seo.mjs";
import { Header, Footer } from "../components/ui";
import { Consent } from "../components/consent";
import { pages, settings, rows } from "../lib/content";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  disableAnalytics?: boolean;
  canonical?: string;
  image?: string;
  kind?: string;
  topicFeed?: string;
  structured?: any;
}
const {
  title,
  description,
  noindex = false,
  disableAnalytics = false,
  canonical,
  image,
  kind = "website",
  topicFeed,
  structured,
} = Astro.props;
const config = settings();
const url = canonicalURL(Astro.url.pathname, config.site_url, canonical);
const fullTitle = title
  ? title + " | " + config.title + " · " + config.author_name
  : config.title + " — " + config.author_name + " | Pomoc i praca socjalna";
const desc = searchDescription(description, config.description);
const robots =
  noindex || !config.allow_indexing
    ? "noindex,follow"
    : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
const nav = pages()
  .filter((p) => p.show_in_nav)
  .sort((a, b) => a.nav_order - b.nav_order);
const ogImage = image || config.default_image || "/og/mostpomocy.png";
const data = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": config.site_url + "/#website",
    name: config.title,
    alternateName: "MostPomocy.pl",
    description: config.description,
    url: config.site_url,
    inLanguage: "pl-PL",
    publisher: {
      "@type": "Person",
      "@id": config.site_url + "/#author",
      name: config.author_name,
      url: config.site_url + "/o-projekcie/",
      sameAs: config.social_profiles,
    },
  },
  ...(structured ? [structured] : []),
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/app-192.png" />
    <meta name="theme-color" content="#174d3e" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="MostPomocy — nowe publikacje"
      href="/feed.xml"
    />
    {topicFeed && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={(title || config.title) + " — aktualności"}
        href={new URL(topicFeed, config.site_url).href}
      />
    )}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={kind} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={config.title} />
    <meta
      name="author"
      content={structured?.author?.name || config.author_name}
    />
    {kind === "article" && structured?.datePublished && (
      <meta
        property="article:published_time"
        content={structured.datePublished}
      />
    )}
    {kind === "article" && structured?.dateModified && (
      <meta
        property="article:modified_time"
        content={structured.dateModified}
      />
    )}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta
      name="twitter:image"
      content={new URL(ogImage, config.site_url).href}
    />
    <meta
      property="og:image:alt"
      content={title || "MostPomocy — Igor Pabiańczyk. O pomaganiu, po ludzku."}
    />
    {(!image || image.startsWith("/og/")) && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    {ogImage && (
      <meta
        property="og:image"
        content={new URL(ogImage, config.site_url).href}
      />
    )}
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    {config.google_verification && (
      <meta
        name="google-site-verification"
        content={config.google_verification}
      />
    )}
    {config.bing_verification && (
      <meta name="msvalidate.01" content={config.bing_verification} />
    )}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(data).replace(/</g, "\u003c")}
    ></script>
  </head>
  <body>
    <Header
      navigation={[
        ...nav.map((p) => ({
          slug: (p.section === "sosnowiec" ? "sosnowiec/" : "") + p.slug,
          title: p.title,
          menu_label: p.menu_label,
        })),
        ...config.navigation.map((n: any) => ({
          slug: n.url,
          title: n.label,
          url: n.url,
        })),
      ]}
      client:load
    />
    {!Astro.url.pathname.startsWith("/admin") &&
      rows("banners")
        .filter(
          (b) =>
            ["published", "scheduled"].includes(b.status) &&
            (!b.published_at || Date.parse(b.published_at) <= Date.now()) &&
            (b.scope === "all" || Astro.url.pathname.startsWith("/sosnowiec")),
        )
        .slice(0, 3)
        .map((b) => (
          <aside class="container site-notice" aria-label="Komunikat">
            <strong>{b.title}</strong>
            <p>{b.description}</p>
            {b.url && <a href={b.url}>Dowiedz się więcej →</a>}
          </aside>
        ))}
    <slot />
    <Footer note={config.footer_note} />
    <nav class="app-bottom" aria-label="Nawigacja aplikacji">
      <a href="/aplikacja/">Start</a>
      <a href="/szukaj/">Szukaj</a>
      <a href="/zapisane/">Teczka</a>
      <a href="/nowosci/">Nowości</a>
    </nav>
    {!disableAnalytics && (
      <Consent measurementId={config.ga_measurement_id} client:load />
    )}
    <script>
      if (
        "serviceWorker" in navigator &&
        !location.pathname.startsWith("/admin")
      ) {
        window.addEventListener("load", () =>
          navigator.serviceWorker.register("/sw.js").catch(() => {}),
        );
      }
    </script>
    <script>
      document.addEventListener("click", (event) => {
        const link = (event.target as Element)?.closest('a[href^="#"]');
        if (!link) return;
        const target = document.getElementById(
          link.getAttribute("href")!.slice(1),
        );
        if (target && link.classList.contains("skip")) {
          target.setAttribute("tabindex", "-1");
          target.focus();
        }
      });
    </script>
  </body>
</html>
