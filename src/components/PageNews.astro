---
import { published, rows, pagePath, type RecordData } from "../lib/content";
import { pageArticles } from "../lib/page-news.mjs";
import { ArticleCard } from "./ui";
const { page } = Astro.props;
const articles: RecordData[] = pageArticles(page, published());
---

{(page.show_updates || articles.length > 0) && (
  <section id="aktualnosci" class="related" aria-label="Aktualności i artykuły">
    <span class="eyebrow">NA BIEŻĄCO</span>
    <h2>Aktualności i artykuły</h2>
    {!page.noindex && (
      <p>
        <a class="text-link" href={pagePath(page) + "feed.xml"}>
          Obserwuj ten temat przez RSS →
        </a>
      </p>
    )}
    {articles.length > 0 ? (
      <div class="article-grid">
        {articles.map((post) => (
          <ArticleCard post={post} categories={rows("categories")} />
        ))}
      </div>
    ) : (
      <p class="lead narrow">
        W tym miejscu pojawią się wiadomości, relacje i artykuły dotyczące tego
        tematu. Wróć, aby sprawdzić nowe publikacje.
      </p>
    )}
  </section>
)}
