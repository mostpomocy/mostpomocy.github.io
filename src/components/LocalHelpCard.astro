---
interface Props { title: string; description: string; points: string[]; }
const { title, description, points } = Astro.props;
---
<article class="card local-card">
  <h3>{title}</h3>
  <p>{description}</p>
  {points.length > 0 && (
    <ul>
      {points.map((point) => <li>{point}</li>)}
    </ul>
  )}
</article>
<style>
  .local-card { padding: 1rem; }
  h3 { margin: 0 0 .35rem; color: var(--navy); }
  p { margin: 0; color: var(--muted); }
  ul { margin: .75rem 0 0; padding-left: 1rem; }
</style>
