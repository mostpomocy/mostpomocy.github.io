---
import ArticleCard from './ArticleCard.astro';
interface Post {
  slug: string;
  data: {
    title: string;
    description: string;
    publicationDate: Date;
    category: string;
    tags: string[];
    featuredImage: string;
    featuredImageAlt: string;
  };
}
interface Props { posts: Post[]; basePath: string; }
const { posts, basePath } = Astro.props;
---
<div class="grid article-grid">
  {posts.map((post) => (
    <ArticleCard
      href={`${basePath}/${post.slug}/`}
      title={post.data.title}
      description={post.data.description}
      date={post.data.publicationDate}
      category={post.data.category}
      tags={post.data.tags}
      image={post.data.featuredImage}
      imageAlt={post.data.featuredImageAlt}
    />
  ))}
</div>
<style>
  .article-grid { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
</style>
