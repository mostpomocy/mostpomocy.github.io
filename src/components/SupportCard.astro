---
interface Props { href: string; title: string; description: string; }
const { href, title, description } = Astro.props;
---
<a class="support-card card" href={href}>
  <h3>{title}</h3>
  <p>{description}</p>
</a>
<style>
  .support-card { padding: 1rem; text-decoration: none; color: inherit; display: grid; gap: .45rem; }
  .support-card:hover { border-color: #8bc9d1; }
  h3 { margin: 0; font-size: 1.1rem; color: var(--navy); }
  p { margin: 0; color: var(--muted); }
</style>
