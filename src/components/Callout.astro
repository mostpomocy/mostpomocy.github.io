---
interface Props { title: string; content: string; tone?: 'info' | 'alert'; }
const { title, content, tone = 'info' } = Astro.props;
---
<aside class={`callout ${tone}`}>
  <h3>{title}</h3>
  <p>{content}</p>
</aside>
<style>
  .callout { padding: 1rem; border-radius: .85rem; margin: 1rem 0; border: 1px solid transparent; }
  .callout.info { background: var(--teal-light); border-color: #bfedf0; }
  .callout.alert { background: #fff3f2; border-color: #f9cbc7; }
  h3 { margin: 0 0 .35rem; }
  p { margin: 0; }
</style>
