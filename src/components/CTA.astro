---
interface Props { title: string; description: string; primary: { label: string; href: string }; secondary?: { label: string; href: string }; }
const { title, description, primary, secondary } = Astro.props;
---
<section class="cta card">
  <h2>{title}</h2>
  <p>{description}</p>
  <div class="actions">
    <a class="button button-primary" href={primary.href}>{primary.label}</a>
    {secondary && <a class="button button-secondary" href={secondary.href}>{secondary.label}</a>}
  </div>
</section>
<style>
  .cta { padding: 1.5rem; }
  h2 { margin: 0 0 .5rem; }
  p { margin: 0; color: var(--muted); }
  .actions { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: .65rem; }
</style>
