---
const { appId, siteUrl } = Astro.props;
---

<section
  class="content-tile push-settings"
  data-app-id={appId || ""}
  data-site-url={siteUrl}
>
  <h2>Wybrane powiadomienia</h2>
  <p>
    Nowy poradnik albo wiadomości z Sosnowca — wybierasz tematy i możesz je
    wyłączyć. Bez konta i bez adresu e-mail.
  </p>
  {appId ? (
    <>
      <fieldset>
        <legend>Co chcesz otrzymywać?</legend>
        <label>
          <input type="checkbox" name="mp_poradniki" /> Nowe poradniki
        </label>
        <label>
          <input type="checkbox" name="mp_sosnowiec" /> Sosnowiec
        </label>
      </fieldset>
      <p>
        Obsługę zapewnia OneSignal. Po przygotowaniu połączenia przekażemy
        dostawcy dane techniczne przeglądarki, a po zapisaniu także
        identyfikator subskrypcji i wybrane tematy.{" "}
        <a href="/polityka-prywatnosci/">Informacja o prywatności</a>.
      </p>
      <button class="button dark" data-push-prepare>
        Przygotuj powiadomienia
      </button>
      <button class="button dark" data-push-enable hidden>
        Włącz powiadomienia
      </button>
      <button class="button" data-push-save hidden>
        Zapisz tematy
      </button>
      <button class="button" data-push-stop hidden>
        Wyłącz powiadomienia
      </button>
      <p data-push-status role="status">
        Po przygotowaniu połączenia osobno potwierdzisz zgodę w przeglądarce.
      </p>
      <noscript>
        Powiadomienia wymagają JavaScript. Możesz korzystać z RSS bez skryptów.
      </noscript>
    </>
  ) : (
    <p>
      Uruchamiamy zapisy na powiadomienia. Na razie nowe artykuły możesz
      obserwować przez RSS.
    </p>
  )}
  <p>
    Na iPhonie (iOS 16.4 lub nowszy) najpierw dodaj MostPomocy do ekranu
    początkowego i otwórz aplikację z ikony. Instalacja nie włącza powiadomień.
  </p>
</section>
<style>
  fieldset {
    border: 1px solid var(--line, #c8d0c8);
    padding: 1rem;
    margin: 1rem 0;
  }
  legend {
    font-weight: 700;
    padding: 0 0.3rem;
  }
  label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
    cursor: pointer;
  }
  input {
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    accent-color: #174d3e;
  }
  button {
    margin: 0.3rem 0.3rem 0.3rem 0;
  }
  button[hidden] {
    display: none;
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>(".push-settings");
  if (root?.dataset.appId) {
    const prepare = root.querySelector<HTMLButtonElement>(
      "[data-push-prepare]",
    )!;
    const enable = root.querySelector<HTMLButtonElement>("[data-push-enable]")!;
    const save = root.querySelector<HTMLButtonElement>("[data-push-save]")!;
    const stop = root.querySelector<HTMLButtonElement>("[data-push-stop]")!;
    const status = root.querySelector<HTMLElement>("[data-push-status]")!;
    const topics = [
      ...root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'),
    ];
    const key = "mp-push-preferences-v1";
    let sdk: any;
    let starting: Promise<any> | undefined;
    const say = (message: string) => {
      status.textContent = message;
    };
    const preferences = () =>
      Object.fromEntries(
        topics.map((input) => [input.name, input.checked ? "1" : "0"]),
      );
    const remember = () => {
      try {
        localStorage.setItem(key, JSON.stringify(preferences()));
      } catch {}
    };
    try {
      const stored = JSON.parse(localStorage.getItem(key) || "{}");
      topics.forEach((input) => {
        input.checked = stored[input.name] === "1";
      });
    } catch {}
    function refresh() {
      const active = !!sdk?.User.PushSubscription.optedIn;
      prepare.hidden = !!sdk;
      enable.hidden = !sdk || active;
      save.hidden = !active;
      stop.hidden = !active;
    }
    async function initialize() {
      if (sdk) return sdk;
      if (starting) return starting;
      starting = new Promise((resolve, reject) => {
        const w = window as any;
        const timeout = window.setTimeout(
          () =>
            reject(
              Error(
                "Nie udało się połączyć. Sprawdź połączenie lub blokadę skryptów i spróbuj ponownie po odświeżeniu strony.",
              ),
            ),
          20000,
        );
        w.OneSignalDeferred = w.OneSignalDeferred || [];
        w.OneSignalDeferred.push(async (OneSignal: any) => {
          try {
            await OneSignal.init({
              appId: root!.dataset.appId,
              serviceWorkerPath: "push/onesignal/OneSignalSDKWorker.js",
              serviceWorkerParam: { scope: "/push/onesignal/" },
              autoResubscribe: false,
              notifyButton: { enable: false },
              welcomeNotification: { disable: true },
              promptOptions: {
                slidedown: { prompts: [{ type: "push", autoPrompt: false }] },
              },
            });
            sdk = OneSignal;
            sdk.User.PushSubscription.addEventListener("change", refresh);
            // Existing subscriptions may have been edited on another visit.
            if (sdk.User.PushSubscription.optedIn) {
              const tags = sdk.User.getTags();
              topics.forEach((input) => {
                input.checked = tags[input.name] === "1";
              });
              remember();
            }
            window.clearTimeout(timeout);
            resolve(sdk);
          } catch (error) {
            window.clearTimeout(timeout);
            reject(error);
          }
        });
        const script = document.createElement("script");
        script.src =
          "https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js";
        script.async = true;
        script.onerror = () => {
          window.clearTimeout(timeout);
          reject(
            Error(
              "Nie udało się wczytać OneSignal. Spróbuj ponownie po odświeżeniu strony.",
            ),
          );
        };
        document.head.appendChild(script);
      });
      return starting;
    }
    function errorMessage(error: unknown) {
      say(
        error instanceof Error
          ? error.message
          : "Nie udało się zapisać. Spróbuj ponownie.",
      );
    }
    prepare.addEventListener("click", async () => {
      if (location.origin !== new URL(root!.dataset.siteUrl!).origin) {
        say(
          "Zapisy działają na mostpomocy.pl. Podgląd lokalny nie zapisuje urządzenia.",
        );
        return;
      }
      if (
        !("Notification" in window) ||
        !("PushManager" in window) ||
        !("serviceWorker" in navigator)
      ) {
        say(
          "Ta przeglądarka nie obsługuje zapisów w tym widoku. Na iPhonie dodaj stronę do ekranu początkowego, otwórz z ikony i spróbuj ponownie. Możesz też korzystać z RSS.",
        );
        return;
      }
      if (!topics.some((input) => input.checked)) {
        say("Wybierz przynajmniej jeden temat.");
        return;
      }
      prepare.disabled = true;
      say("Przygotowuję połączenie z OneSignal…");
      try {
        await initialize();
        refresh();
        say(
          sdk.User.PushSubscription.optedIn
            ? "Powiadomienia są włączone. Możesz zmienić tematy lub je wyłączyć."
            : "Połączenie gotowe. Naciśnij „Włącz powiadomienia”, aby potwierdzić zgodę w przeglądarce.",
        );
      } catch (error) {
        errorMessage(error);
      } finally {
        prepare.disabled = false;
      }
    });
    enable.addEventListener("click", async () => {
      if (!sdk) return;
      if (!topics.some((input) => input.checked)) {
        say("Wybierz przynajmniej jeden temat.");
        return;
      }
      if (Notification.permission === "denied") {
        say(
          "Powiadomienia są zablokowane w ustawieniach przeglądarki. Odblokuj je dla mostpomocy.pl, jeśli chcesz się zapisać.",
        );
        return;
      }
      enable.disabled = true;
      try {
        // Called directly from a separate user click, preserving the iOS user gesture.
        await sdk.Notifications.requestPermission();
        if (!sdk.Notifications.permission) {
          say("Nie udzielono zgody. Możesz nadal korzystać ze strony i RSS.");
          return;
        }
        await sdk.User.PushSubscription.optIn();
        await sdk.User.addTags(preferences());
        remember();
        refresh();
        say(
          sdk.User.PushSubscription.optedIn
            ? "Powiadomienia włączone dla wybranych tematów."
            : "Zgoda przyjęta. Rejestracja urządzenia jeszcze trwa.",
        );
      } catch (error) {
        errorMessage(error);
      } finally {
        enable.disabled = false;
      }
    });
    save.addEventListener("click", async () => {
      if (!topics.some((input) => input.checked)) {
        say("Wybierz temat albo naciśnij „Wyłącz powiadomienia”.");
        return;
      }
      save.disabled = true;
      try {
        await sdk.User.addTags(preferences());
        remember();
        say("Zapisano wybrane tematy.");
      } catch (error) {
        errorMessage(error);
      } finally {
        save.disabled = false;
      }
    });
    stop.addEventListener("click", async () => {
      stop.disabled = true;
      try {
        await sdk.User.PushSubscription.optOut();
        topics.forEach((input) => {
          input.checked = false;
        });
        remember();
        refresh();
        say("Powiadomienia wyłączone na tej przeglądarce.");
      } catch (error) {
        errorMessage(error);
      } finally {
        stop.disabled = false;
      }
    });
  }
</script>
