---
interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  category: string;
  tags: string[];
  image: string;
  imageAlt: string;
}
const { href, title, description, date, category, tags, image, imageAlt } = Astro.props;
---
<article class="article-card card">
  <a href={href} class="cover-link">
    <img src={image} alt={imageAlt} loading="lazy" />
  </a>
  <div class="content">
    <p class="meta">{date.toLocaleDateString('pl-PL')} · {category}</p>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <div class="tags">{tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}</div>
  </div>
</article>
<style>
  .article-card { overflow: hidden; }
  .cover-link { display: block; background: #dce8f2; aspect-ratio: 16/9; }
  img { width: 100%; height: 100%; object-fit: cover; }
  .content { padding: 1rem; }
  .meta { margin: 0 0 .35rem; color: var(--muted); font-size: .9rem; }
  h3 { margin: 0 0 .45rem; font-size: 1.15rem; }
  h3 a { text-decoration: none; color: var(--navy); }
  p { margin: 0; color: var(--muted); }
  .tags { margin-top: .6rem; display: flex; flex-wrap: wrap; gap: .4rem; }
</style>
