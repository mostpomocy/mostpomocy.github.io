---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  description: string;
  ctas?: { label: string; href: string; variant?: 'primary' | 'secondary' }[];
}
const { eyebrow, title, subtitle, description, ctas = [] } = Astro.props;
---
<section class="hero section">
  <div class="container hero-box card">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p class="subtitle">{subtitle}</p>
    <p class="description">{description}</p>
    {ctas.length > 0 && (
      <div class="actions">
        {ctas.map((cta) => (
          <a class={`button ${cta.variant === 'secondary' ? 'button-secondary' : 'button-primary'}`} href={cta.href}>{cta.label}</a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .hero-box { padding: clamp(1.5rem, 4vw, 3rem); background: linear-gradient(180deg, #fff 0%, #f5fbff 100%); }
  h1 { margin: 0 0 .25rem; font-size: clamp(2rem, 5vw, 3.4rem); color: var(--navy); line-height: 1.1; }
  .eyebrow { margin: 0; color: var(--teal); font-weight: 700; letter-spacing: .03em; text-transform: uppercase; }
  .subtitle { margin: 0 0 .75rem; font-size: clamp(1.3rem, 3vw, 2rem); font-weight: 700; }
  .description { margin: 0; max-width: 72ch; color: var(--muted); }
  .actions { margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: .75rem; }
</style>
