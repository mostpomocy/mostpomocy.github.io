---
import PageNews from "../components/PageNews.astro";
import Questions from "../components/Questions.astro";
import Base from "../layouts/Base.astro";
import { pages, rows, prepareBody, siteURL } from "../lib/content";

import { visible } from "../lib/schema.mjs";
export function getStaticPaths() {
  return (
    import.meta.env.DEV
      ? rows("pages").filter((p) => p.status !== "trashed")
      : pages()
  )
    .filter((p) => p.section !== "sosnowiec")
    .map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const { body } = prepareBody(page.body);
---

<Base
  topicFeed={
    !page.noindex && visible(page) ? "/" + page.slug + "/feed.xml" : undefined
  }
  title={page.seo_title || page.title}
  description={page.seo_description || page.excerpt}
  noindex={page.noindex || !visible(page)}
  structured={{
    "@context": "https://schema.org",
    "@type": page.show_updates ? "CollectionPage" : "WebPage",
    name: page.title,
    description: page.seo_description || page.excerpt,
    url: siteURL("/" + page.slug + "/"),
    datePublished: page.published_at,
    dateModified: page.updated_at,
    inLanguage: "pl-PL",
  }}
  canonical={page.canonical_url || siteURL("/" + page.slug + "/")}
>
  <main id="main" tabindex="-1" class="container inner-page custom-page">
    {!visible(page) && (
      <p class="preview-notice">
        Lokalny podgląd szkicu. Podstrona nie jest publikowana.
      </p>
    )}
    <span class="eyebrow">MOSTPOMOCY</span>
    <h1>{page.title}</h1>
    {page.notice && (
      <aside class="project-notice">
        <span class="eyebrow">STATUS PROJEKTU</span>
        <p>{page.notice}</p>
      </aside>
    )}
    {page.excerpt && <p class="lead narrow">{page.excerpt}</p>}
    {page.show_updates && (
      <p>
        <a class="button" href="#aktualnosci">
          Aktualności i artykuły ↓
        </a>
      </p>
    )}
    <article class="prose narrow" set:html={body} />
    <PageNews page={page} />
    <Questions items={page.faq} />
  </main>
</Base>
