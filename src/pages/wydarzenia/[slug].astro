---
import Base from "../../layouts/Base.astro";
import { rows, date } from "../../lib/content";
import { visible } from "../../lib/schema.mjs";
export function getStaticPaths() {
  return rows("events")
    .filter((e) => visible(e))
    .map((event) => ({ params: { slug: event.slug }, props: { event } }));
}
const { event: e } = Astro.props;
---

<Base
  title={e.seo_title || e.title}
  description={e.seo_description || e.excerpt}
  noindex={e.noindex}
>
  <main id="main" class="container inner-page" tabindex="-1">
    <a href="/wydarzenia/">← Wszystkie wydarzenia</a>
    <h1>{e.title}</h1>
    <p class="lead">{e.excerpt}</p>
    <div class="info-box">
      <p>
        <strong>Termin:</strong> {date(e.starts_at)} ·{" "}
        {new Intl.DateTimeFormat("pl-PL", {
          hour: "2-digit",
          minute: "2-digit",
          timeZone: "Europe/Warsaw",
        }).format(new Date(e.starts_at))}{" "}
        (czas w Polsce)
      </p>
      <p>
        <strong>Miejsce:</strong> {e.location || "Sprawdź u organizatora"}
      </p>
      <p>
        <strong>Organizator:</strong>{" "}
        {e.organizer || "Informacja nie została podana"}
      </p>
      <p>
        <strong>Dostępność:</strong>{" "}
        {e.accessibility ||
          "Brak potwierdzonych informacji. Skontaktuj się z organizatorem przed udziałem."}
      </p>
      <a class="button" href={`/wydarzenia/${e.id}.ics`} download>
        Dodaj do kalendarza
      </a>
      {e.registration_url && (
        <a
          class="button dark"
          href={e.registration_url}
          rel="noopener noreferrer"
        >
          Informacje o zapisach ↗
        </a>
      )}
    </div>
    <article class="prose" set:html={e.body} />
  </main>
</Base>
