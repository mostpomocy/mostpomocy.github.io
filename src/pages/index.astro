---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SupportGrid from '../components/SupportGrid.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import CTA from '../components/CTA.astro';

const wsparcie = (await getCollection('wsparcie')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'pl'));
const blogPolska = (await getCollection('blog-polska', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publicationDate.getTime() - a.data.publicationDate.getTime())
  .slice(0, 3);
const blogSosnowiec = (await getCollection('blog-sosnowiec', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publicationDate.getTime() - a.data.publicationDate.getTime())
  .slice(0, 3);
---
<BaseLayout
  title="MostPomocy.pl"
  description="Znajdź pomoc. Nie jesteś sam. MostPomocy.pl to przewodnik po wsparciu i pierwszym kontakcie z pomocą."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'MostPomocy.pl',
    url: 'https://www.mostpomocy.pl/',
  }}
>
  <Hero
    title="MOSTPOMOCY.PL"
    subtitle="Znajdź pomoc. Nie jesteś sam."
    description="Most między Tobą a pomocą. Pomagamy znaleźć właściwą drogę do wsparcia, zrozumieć dostępne możliwości i zrobić pierwszy krok."
    ctas={[
      { label: 'Zobacz rodzaje wsparcia', href: '/wsparcie/' },
      { label: 'Pomoc w Sosnowcu', href: '/sosnowiec/', variant: 'secondary' },
    ]}
  />

  <EmergencyBanner />

  <section class="section">
    <div class="container">
      <SectionHeader
        title="Jakiego wsparcia potrzebujesz?"
        description="Wybierz obszar, aby zobaczyć bezpieczny plan pierwszych kroków oraz wiarygodne źródła."
      />
      <SupportGrid items={wsparcie.map((entry) => ({ slug: entry.slug, title: entry.data.title, shortDescription: entry.data.shortDescription }))} />
    </div>
  </section>

  <section class="section">
    <div class="container grid" style="grid-template-columns:repeat(auto-fit,minmax(250px,1fr));">
      <a class="card feature-link" href="/kompas-pomocy/"><h2>Kompas Pomocy</h2><p>Przewodnik krok po kroku, od pierwszego sygnału do konkretnego działania.</p></a>
      <a class="card feature-link" href="/sosnowiec/"><h2>Sosnowiec</h2><p>Lokalny przewodnik po wsparciu miejskim i obywatelskim.</p></a>
      <a class="card feature-link" href="/bezpiecznik/"><h2>Bezpiecznik</h2><p>Materiały bezpieczeństwa i szybkie instrukcje działania.</p></a>
      <a class="card feature-link" href="/edukacja/"><h2>Edukacja</h2><p>Treści wzmacniające kompetencje i świadomość społeczną.</p></a>
      <a class="card feature-link" href="/o-projekcie/"><h2>O projekcie</h2><p>Misja, założenia oraz sposób rozwoju MostPomocy.pl.</p></a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader title="Blog ogólnopolski" description="Artykuły edukacyjne i praktyczne poradniki dla całej Polski." />
      <ArticleGrid posts={blogPolska} basePath="/blog" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader title="Blog Sosnowiec" description="Lokalne informacje, inicjatywy i praktyczne wskazówki dla mieszkańców." />
      <ArticleGrid posts={blogSosnowiec} basePath="/sosnowiec/blog" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CTA
        title="Potrzebujesz spokojnego pierwszego kroku?"
        description="Zacznij od kategorii wsparcia lub lokalnego przewodnika. Nie musisz przechodzić przez to samodzielnie."
        primary={{ label: 'Przejdź do wsparcia', href: '/wsparcie/' }}
        secondary={{ label: 'Przejdź do Sosnowca', href: '/sosnowiec/' }}
      />
    </div>
  </section>

  <style>
    .feature-link { padding: 1.2rem; text-decoration: none; color: inherit; }
    .feature-link h2 { margin: 0 0 .4rem; font-size: 1.2rem; color: var(--navy); }
    .feature-link p { margin: 0; color: var(--muted); }
  </style>
</BaseLayout>
