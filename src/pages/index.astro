---
import Questions from "../components/Questions.astro";
import Follow from "../components/Follow.astro";
import Base from "../layouts/Base.astro";
import { published, rows, settings, pages, pagePath } from "../lib/content";
import { ArticleCard, Bridge } from "../components/ui";
const config = settings();
const all = published();
const categories = rows("categories");
const guides = pages();
const paths = [
  {
    id: "4fef2246-b096-5d04-b9ec-542640dcb2cd",
    title: "Brakuje mi pieniędzy",
    description: "Jedzenie, rachunki i codzienne wydatki.",
  },
  {
    id: "",
    href: "/od-czego-zaczac/",
    title: "Jest mi trudno",
    description: "Gorszy czas, samotność, niepokój. Nie musisz tego nazywać.",
  },
  {
    id: "0c167bee-8fef-5b46-890f-67c7830135a6",
    title: "Niepełnosprawność",
    description: "Orzeczenie, dofinansowanie i codzienna samodzielność.",
  },
  {
    id: "639879aa-103e-55ed-8a43-8d28a6415a39",
    title: "Rodzina i dzieci",
    description: "Rodzicielstwo, świadczenia i wsparcie bliskich.",
  },
  {
    id: "a9e66d47-ff17-591c-b885-4eb21d317546",
    title: "Choroba i opieka",
    description: "Pomoc na co dzień — dla chorej osoby i opiekuna.",
  },
  {
    id: "fd201bbb-cf04-5e38-9c21-c643cadc6372",
    title: "Mieszkanie i schronienie",
    description: "Opłaty za lokal albo brak bezpiecznego miejsca na noc.",
  },
]
  .map((p) => ({
    ...p,
    href:
      p.href ||
      (guides.find((g) => g.id === p.id)
        ? pagePath(guides.find((g) => g.id === p.id)!)
        : ""),
  }))
  .filter((p) => p.href);
const contacts = [
  "34c283a4-7fbf-5dfa-88d4-f5aeeafadacc",
  "4ee69169-ddfb-5337-a702-1f7cb92142b4",
  "3db0472f-bada-5142-af27-ed83f6bb27d8",
]
  .map((id) =>
    rows("places").find((p) => p.id === id && p.status === "published"),
  )
  .filter(Boolean);
const featured = all.find((p) => p.featured) || all[0];
---

<Base description={config.description}>
  <main id="main" tabindex="-1" class="home-page">
    <div class="container">
      <div class="eyebrow intro-label">
        NIE MUSISZ WIEDZIEĆ WSZYSTKIEGO, ŻEBY ZACZĄĆ.
      </div>
      <section class="intro">
        <h1>
          O pomaganiu.
          <br />
          <em>Po ludzku.</em>
        </h1>
        <div>
          <p>
            Szukasz wsparcia dla siebie lub bliskiej osoby? Znajdziesz tu
            przystępne poradniki i pierwszy krok do rozmowy o pomocy. A w
            Sosnowcu — także konkretne miejsca i kontakty.
          </p>
          <div class="intro-actions">
            <a class="button dark primary-help" href="#pierwszy-krok">
              Znajdź pomoc dla siebie <span aria-hidden="true">→</span>
            </a>
            <a class="text-link" href="/blog/">
              Chcę poczytać poradniki
            </a>
          </div>
        </div>
      </section>
      <section
        id="pierwszy-krok"
        tabindex="-1"
        class="start-paths"
        aria-labelledby="start-heading"
      >
        <span class="eyebrow">TWÓJ PIERWSZY KROK</span>
        <div class="start-heading">
          <h2 id="start-heading">W czym potrzebujesz pomocy?</h2>
          <p>
            Wybierz to, co jest Ci najbliższe. W przewodnikach znajdziesz
            kontakty z Sosnowca; artykuły są dla każdego.
          </p>
        </div>
        <div class="start-grid">
          {paths.map((p, i) => (
            <a class="start-card" href={p.href}>
              <span class="start-number" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <span class="start-next">
                Zobacz pierwszy krok <span aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
        <a class="safety-link" href="/sosnowiec/przemoc/">
          Jeśli ktoś Cię krzywdzi — znajdź pomoc w związku z przemocą{" "}
          <span aria-hidden="true">→</span>
        </a>
      </section>
      <section class="unsure-path" aria-labelledby="unsure-heading">
        <div>
          <span class="eyebrow">NIE MUSISZ MIEĆ GOTOWYCH ODPOWIEDZI</span>
          <h2 id="unsure-heading">Nie wiesz, który temat wybrać?</h2>
          <p>
            Zacznij od tego, czy szukasz czegoś dla siebie, martwisz się o
            bliską osobę czy potrzebujesz kontaktu w mieście.
          </p>
        </div>
        <a class="button" href="/od-czego-zaczac/">
          Przejdź krok po kroku <span aria-hidden="true">→</span>
        </a>
      </section>
      <section class="home-directory" aria-labelledby="directory-heading">
        <div class="section-top">
          <div>
            <span class="eyebrow">KONKRETNE MIEJSCA. JEDNO MIASTO.</span>
            <h2 id="directory-heading">Gdzie zapytać w Sosnowcu?</h2>
          </div>
          <a class="text-link" href="/sosnowiec/?zakladka=mops">
            MOPS, działy i inne instytucje <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="home-contact-grid">
          {contacts.map(
            (p) =>
              p && (
                <article class="home-contact">
                  <h3>{p.name}</h3>
                  <p>{p.description}</p>
                  {p.address && <p class="contact-address">{p.address}</p>}
                  {p.phone && (
                    <a
                      class="contact-phone"
                      href={"tel:" + p.phone.replace(/[^+\d]/g, "")}
                    >
                      Zadzwoń: {p.phone}
                    </a>
                  )}
                  <a
                    class="text-link"
                    href={p.website}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Oficjalne informacje <span aria-hidden="true">↗</span>
                  </a>
                  <p class="verified-date">Dane sprawdzono: {p.verified_at}</p>
                </article>
              ),
          )}
        </div>
        <p class="directory-note">
          Przed wizytą potwierdź godziny i sposób obsługi.{" "}
          <a href="/sosnowiec/blog/">
            Czytaj też blog Sosnowiec <span aria-hidden="true">→</span>
          </a>
        </p>
      </section>
      <section class="home-editorial" aria-label="Wiedza o pomaganiu">
        {featured && (
          <a class="hero" href={"/artykuly/" + featured.slug + "/"}>
            <div class="hero-copy">
              <span class="eyebrow">POMAGANIE ZACZYNA SIĘ OD ROZMOWY</span>
              <h2>{featured.title}</h2>
              <p>{featured.excerpt}</p>
              <div class="hero-bottom">
                <span>Przeczytaj artykuł</span>
                <span class="circle-arrow" aria-hidden="true">
                  ↗
                </span>
              </div>
            </div>
            <div class="hero-art">
              <Bridge />
              <span class="art-caption">
                Każda rozmowa może być początkiem.
              </span>
            </div>
          </a>
        )}
      </section>
      <section class="topics" aria-label="Kategorie">
        <div class="section-kicker">BLIŻEJ TEMATU</div>
        <div class="topic-grid">
          {categories.map((c, i) => (
            <a class="topic" href={"/kategorie/" + c.slug + "/"}>
              <span class="topic-number">{String(i + 1).padStart(2, "0")}</span>
              <strong>{c.name}</strong>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
      <section class="care-paths" aria-label="Wsparcie w chorobie">
        <a href="/wsparcie-onkologiczne/">
          <span class="eyebrow">DLA CIEBIE I BLISKICH</span>
          <h2>
            W chorobie
            <br />
            nowotworowej.
          </h2>
          <p>
            Nie tylko leczenie. Także codzienność, emocje i pomoc w organizacji
            dnia.
          </p>
          <span class="text-link">Zobacz, gdzie zacząć ↗</span>
        </a>
        <a href="/zdrowie-psychiczne/">
          <span class="eyebrow">BEZ ETYKIET I OCENIANIA</span>
          <h2>
            Gdy trudno
            <br />o spokój w głowie.
          </h2>
          <p>
            Wsparcie dla osób z trudnościami psychicznymi, z rozpoznaniem
            choroby i bez niego.
          </p>
          <span class="text-link">Zdrowie psychiczne ↗</span>
        </a>
      </section>
      <section id="artykuly" class="articles">
        <div class="section-top">
          <div>
            <div class="eyebrow">Z BLOGA</div>
            <h2>Warto wiedzieć</h2>
          </div>
          <a class="text-link" href="/blog/">
            Cały blog i wszystkie tematy ↗
          </a>
        </div>
        <div class="article-grid">
          {all.slice(0, 6).map((p) => (
            <ArticleCard post={p} categories={categories} />
          ))}
        </div>
      </section>
      <section class="quiet-note">
        <span class="eyebrow">MAŁY KROK NA DZIŚ</span>
        <h2>Nie musisz mieć gotowej odpowiedzi.</h2>
        <p>
          Możesz przygotować własną kartkę do rozmowy — bez wysyłania prywatnych
          informacji.
        </p>
        <a class="text-link" href="/moja-kartka/">
          Przygotuj i wydrukuj swoją kartkę ↗
        </a>
      </section>
      <section class="author-note">
        <span class="avatar" aria-hidden="true">
          IP
        </span>
        <div>
          <div class="eyebrow">ZA MOSTEM STOI CZŁOWIEK</div>
          <h2>Cześć, jestem Igor.</h2>
          <p>{config.about}</p>
          <a href="/o-projekcie/" class="text-link">
            Poznaj mnie i MostPomocy ↗
          </a>
        </div>
      </section>
    </div>
    <Follow />
    <div class="container"><Questions items={config.faq} /></div>
  </main>
</Base>

<script>
  if (
    location.pathname === "/" &&
    (window.matchMedia("(display-mode: standalone)").matches ||
      (navigator as any).standalone)
  )
    location.replace("/aplikacja/");
</script>
