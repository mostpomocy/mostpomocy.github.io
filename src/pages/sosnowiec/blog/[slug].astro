---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTA from '../../../components/CTA.astro';
import SectionHeader from '../../../components/SectionHeader.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog-sosnowiec', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content } = await post.render();
const sorted = posts.sort((a, b) => a.data.publicationDate.getTime() - b.data.publicationDate.getTime());
const currentIndex = sorted.findIndex((entry) => entry.id === post.id);
const prev = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const next = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
const related = posts
  .filter((entry) => entry.id !== post.id && entry.data.tags.some((tag) => post.data.tags.includes(tag)))
  .slice(0, 3);
---
<BaseLayout
  title={post.data.seo.title}
  description={post.data.seo.description}
  image={post.data.featuredImage}
  breadcrumbs={[
    { name: 'Strona główna', item: 'https://www.mostpomocy.pl/' },
    { name: 'Sosnowiec', item: 'https://www.mostpomocy.pl/sosnowiec/' },
    { name: 'Blog Sosnowiec', item: 'https://www.mostpomocy.pl/sosnowiec/blog/' },
    { name: post.data.title, item: `https://www.mostpomocy.pl/sosnowiec/blog/${post.slug}/` },
  ]}
>
  <article class="section">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Strona główna', href: '/' }, { label: 'Sosnowiec', href: '/sosnowiec/' }, { label: 'Blog Sosnowiec', href: '/sosnowiec/blog/' }, { label: post.data.title }]} />
      <h1>{post.data.title}</h1>
      <p class="meta">{post.data.publicationDate.toLocaleDateString('pl-PL')} · {post.data.category}</p>
      <img src={post.data.featuredImage} alt={post.data.featuredImageAlt} />
      <div class="tags">{post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}</div>
      <div class="body"><Content /></div>

      {related.length > 0 && (
        <>
          <SectionHeader title="Powiązane artykuły lokalne" />
          <ul>{related.map((item) => <li><a href={`/sosnowiec/blog/${item.slug}/`}>{item.data.title}</a></li>)}</ul>
        </>
      )}

      <nav class="adjacent" aria-label="Nawigacja artykułów">
        {prev ? <a href={`/sosnowiec/blog/${prev.slug}/`}>← {prev.data.title}</a> : <span></span>}
        {next ? <a href={`/sosnowiec/blog/${next.slug}/`}>{next.data.title} →</a> : <span></span>}
      </nav>

      <CTA title="Sprawdź lokalne wsparcie" description="Wróć do przewodnika po wsparciu w Sosnowcu lub przejdź do wszystkich kategorii." primary={{ label: 'Pomoc w Sosnowcu', href: '/sosnowiec/' }} secondary={{ label: 'Rodzaje wsparcia', href: '/wsparcie/' }} />
    </div>
  </article>
  <style>
    h1 { margin-bottom: .35rem; }
    .meta { margin-top: 0; color: var(--muted); }
    .tags { margin: .75rem 0; display: flex; flex-wrap: wrap; gap: .45rem; }
    .body { margin: 1rem 0 1.5rem; }
    .body :global(p), .body :global(li) { color: var(--muted); }
    .adjacent { margin: 1.5rem 0; display: flex; justify-content: space-between; gap: .75rem; }
    .adjacent a { font-weight: 700; }
  </style>
</BaseLayout>
