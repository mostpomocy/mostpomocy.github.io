---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<BaseLayout title="Kompas Pomocy" description="Kompas Pomocy: jak krok po kroku przejść od potrzeby do wsparcia.">
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Strona główna', href: '/' }, { label: 'Kompas Pomocy' }]} />
      <h1>Kompas Pomocy</h1>
      <ol>
        <li>Nazwij problem i jego pilność.</li>
        <li>Wybierz kategorię wsparcia.</li>
        <li>Przygotuj pierwszy kontakt (notatka, dokumenty, pytania).</li>
        <li>Sprawdź wiarygodne źródła i dostępne formy pomocy.</li>
      </ol>
    </div>
  </section>
</BaseLayout>
