---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="MostPomocy CMS"
  description="Panel informacyjny MostPomocy CMS. Zarządzanie treściami odbywa się przez Pages CMS."
  noindex={true}
>
  <section class="section">
    <div class="container">
      <article class="card admin-card">
        <h1>MostPomocy CMS</h1>
        <p>Edycja treści odbywa się przez Pages CMS połączony z repozytorium GitHub.</p>
        <p>
          <a class="button button-primary" href="https://app.pagescms.org/" rel="noopener noreferrer">
            Otwórz panel zarządzania
          </a>
        </p>
      </article>
    </div>
  </section>
  <style>
    .admin-card { padding: 1.5rem; max-width: 700px; }
    h1 { margin-top: 0; }
  </style>
</BaseLayout>
