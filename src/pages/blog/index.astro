---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ArticleGrid from '../../components/ArticleGrid.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const posts = (await getCollection('blog-polska', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publicationDate.getTime() - a.data.publicationDate.getTime(),
);
---
<BaseLayout
  title="Blog ogólnopolski"
  description="Artykuły MostPomocy.pl o wsparciu, zdrowiu i pierwszym kontakcie z pomocą."
  breadcrumbs={[
    { name: 'Strona główna', item: 'https://www.mostpomocy.pl/' },
    { name: 'Blog', item: 'https://www.mostpomocy.pl/blog/' },
  ]}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Strona główna', href: '/' }, { label: 'Blog' }]} />
      <SectionHeader title="Blog ogólnopolski" description="Praktyczne materiały i treści edukacyjne dla osób szukających wsparcia." />
      <ArticleGrid posts={posts} basePath="/blog" />
    </div>
  </section>
</BaseLayout>
