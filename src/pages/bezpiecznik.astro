---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<BaseLayout title="Bezpiecznik" description="Materiały bezpieczeństwa i szybkie instrukcje reagowania.">
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Strona główna', href: '/' }, { label: 'Bezpiecznik' }]} />
      <h1>Bezpiecznik / materiały</h1>
      <p>W tej sekcji znajdują się krótkie instrukcje działania w sytuacjach kryzysowych oraz materiały wspierające bezpieczną komunikację.</p>
    </div>
  </section>
</BaseLayout>
