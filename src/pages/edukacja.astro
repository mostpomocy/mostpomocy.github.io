---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<BaseLayout title="Edukacja" description="Treści edukacyjne MostPomocy.pl wspierające świadome korzystanie z pomocy.">
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Strona główna', href: '/' }, { label: 'Edukacja' }]} />
      <h1>Edukacja</h1>
      <p>Materiały edukacyjne budują świadomość praw, narzędzi i form wsparcia. Sekcja jest stale rozwijana wraz z blogiem i kategoriami pomocy.</p>
    </div>
  </section>
</BaseLayout>
